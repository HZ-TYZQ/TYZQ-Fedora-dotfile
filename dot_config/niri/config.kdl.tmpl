// Niri entry point. Select a hosts/ display profile in local chezmoi data.
// Noctalia's generated colors stay last.

include "conf.d/session.kdl"
include "conf.d/input.kdl"
{{ with (get . "niriDisplayProfile") -}}
include {{ printf "hosts/%s.kdl" . | quote }}
{{ end -}}
include "conf.d/appearance.kdl"
include "conf.d/rules.kdl"
include "conf.d/binds.kdl"

// Generated by Noctalia's built-in Niri theme template.
include "noctalia.kdl"
