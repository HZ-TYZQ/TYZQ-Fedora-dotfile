{
  "layer": "top",
  "position": "top",
  "height": 40,
  "margin-top": 8,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 6,

  "modules-left": [
    "custom/launcher",
    "niri/workspaces",
    "niri/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "network",
    "pulseaudio",
    "backlight",
    "power-profiles-daemon",
    "battery"
  ],

  "custom/launcher": {
    "format": "",
    "tooltip-format": "打开应用启动器",
    "on-click": "fuzzel"
  },

  "niri/workspaces": {
    "all-outputs": false,
    "format": "{index}"
  },

  "niri/window": {
    "format": "{title}",
    "icon": true,
    "icon-size": 18,
    "max-length": 48,
    "separate-outputs": true
  },

  "clock": {
    "format": "󰥔  {:%H:%M}",
    "format-alt": "󰃭  {:%Y-%m-%d  %A}",
    "tooltip-format": "<big>{:%Y年 %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "tray": {
    "icon-size": 18,
    "spacing": 8
  },

  "network": {
    "interval": 3,
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀  有线",
    "format-linked": "󰈀  连接中",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid}\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}"
  },

  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon}  {volume}%",
    "format-muted": "󰖁  静音",
    "format-bluetooth": "󰂯  {volume}%",
    "format-icons": {
      "headphone": "",
      "headset": "󰋎",
      "default": ["", "", ""]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "backlight": {
    "scroll-step": 5,
    "format": "{icon}  {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"]
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "电源模式：{profile}",
    "format-icons": {
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰌪"
    }
  },

  "battery": {
    "interval": 5,
    "states": {
      "warning": 25,
      "critical": 12
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-full": "󰁹  {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁽", "󰁿", "󰂁", "󰁹"],
    "tooltip-format": "{time}\n功耗：{power:.1f} W"
  }
}
