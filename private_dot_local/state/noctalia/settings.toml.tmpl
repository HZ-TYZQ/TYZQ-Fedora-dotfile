{{- $settings := dict -}}
{{- $path := joinPath .chezmoi.destDir ".local/state/noctalia/settings.toml" -}}
{{- if stat $path -}}
{{- $settings = include $path | fromToml -}}
{{- end -}}
config_version = 15

[backdrop]
blur_intensity = 0.0
tint_intensity = 0.4999999888241291

[bar]
order = [ "default" ]

    [bar.default]
    capsule = true
    capsule_thickness = 0.89999998360872269
    center = [ "taskbar", "clock" ]
    end = [ "tray", "notifications", "clipboard", "network", "volume", "brightness", "session" ]
    font_family = "Noto Sans Mono"
    font_weight = 600
    margin_ends = 20
    radius = 80
    scale = 1.2000000104308128
    start = [ "workspaces", "ram", "cpu", "battery", "media" ]
    widget_spacing = 9

[desktop_widgets]
enabled = true
schema_version = 2
widget_order = [
    "starlight_time",
    "starlight_date",
    "desktop-widget-0000000000000001",
    "desktop-widget-0000000000000005",
    "desktop-widget-0000000000000008"
]

    [desktop_widgets.grid]
    cell_size = 16
    major_interval = 4
    visible = true

    [desktop_widgets.widget.desktop-widget-0000000000000001]
    box_height = 128.0
    box_width = 320.0
    cx = 216.0
    cy = 507.5
    output = "eDP-1"
    placement_height = 1143.0
    placement_width = 1829.0
    rotation = 0.0
    type = "weather"

        [desktop_widgets.widget.desktop-widget-0000000000000001.settings]
        background_color = "on_primary"
        background_opacity = 0.0
        show_forecast = false

    [desktop_widgets.widget.desktop-widget-0000000000000005]
    box_height = 192.0
    box_width = 304.0
    cx = 1626.5
    cy = 475.5
    output = "eDP-1"
    placement_height = 1143.0
    placement_width = 1829.0
    rotation = 0.0
    type = "sysmon"

        [desktop_widgets.widget.desktop-widget-0000000000000005.settings]
        background_color = "on_primary"
        background_opacity = 0.0
        color = "on_surface"
        color2 = "on_surface"
        display = "graph"
        stat = "gpu_usage"
        stat2 = "gpu_vram"

    [desktop_widgets.widget.desktop-widget-0000000000000008]
    box_height = 128.0
    box_width = 1824.0
    cx = 914.5
    cy = 1079.0
    output = "eDP-1"
    placement_height = 1143.0
    placement_width = 1829.0
    rotation = 0.0
    type = "audio_visualizer"

        [desktop_widgets.widget.desktop-widget-0000000000000008.settings]
        background = false
        bands = 52
        centered = false
        color_1 = "#FFF2DF"
        color_2 = "#FFF2DF"
        mirrored = true
        reversed = true
        show_when_idle = true

    [desktop_widgets.widget.starlight_date]
    box_height = 64.0
    box_width = 304.0
    cx = 216.0
    cy = 251.5
    output = "eDP-1"
    placement_height = 1143.0
    placement_width = 1829.0
    rotation = 0.0
    type = "clock"

        [desktop_widgets.widget.starlight_date.settings]
        background = false
        clock_style = "digital"
        color = "secondary"
        format = "{:%-B %-d  %A}"
        shadow = true

    [desktop_widgets.widget.starlight_time]
    box_height = 108.0
    box_width = 304.0
    cx = 216.0
    cy = 165.5
    output = "eDP-1"
    placement_height = 1143.0
    placement_width = 1829.0
    rotation = 0.0
    type = "clock"

        [desktop_widgets.widget.starlight_time.settings]
        background = false
        clock_style = "digital"
        color = "on_surface"
        font_family = "Noto Sans Mono"
        format = "{:%H:%M:%S}"
        shadow = true

[dock]
background_opacity = 0.99999997764825821
concave_edge_corners = false
cross_axis_padding = 0
enabled = true
icon_size = 32
item_spacing = 0
launcher_icon = "flare"
launcher_position = "start"
magnification_scale = 1.7000000104308128
main_axis_padding = 0
pinned = [ "com.google.Chrome", "org.gnome.Nautilus", "firefox", "org.localsend.localsend_app", "proton.vpn.app.gtk" ]
radius = 80
reserve_space = false
show_dots = true
smart_auto_hide = true

[idle]
behavior_order = [ "lock", "screen-off", "lock-and-suspend" ]

    [idle.behavior.lock]
    action = "lock"
    enabled = false
    timeout = 600.0

    [idle.behavior.lock-and-suspend]
    action = "lock_and_suspend"
    enabled = true
    timeout = 1500.0

    [idle.behavior.screen-off]
    action = "screen_off"
    enabled = true
    timeout = 660.0

{{ if hasKey $settings "location" -}}
[location]
{{ index $settings "location" | toToml }}
{{ end -}}
[lockscreen_widgets]
enabled = false
schema_version = 2
widget_order = [ "lockscreen-login-box@eDP-1" ]

    [lockscreen_widgets.grid]
    cell_size = 16
    major_interval = 4
    visible = true

    [lockscreen_widgets.widget."lockscreen-login-box@eDP-1"]
    box_height = 196.0
    box_width = 810.0
    cx = 915.0357666015625
    cy = 948.03656005859375
    output = "eDP-1"
    placement_height = 1143.0
    placement_width = 1829.0
    rotation = 0.0
    type = "login_box"

        [lockscreen_widgets.widget."lockscreen-login-box@eDP-1".settings]
        background_color = "surface_variant"
        background_opacity = 0.88
        background_radius = 12.0
        center_password_text = false
        input_opacity = 1.0
        input_radius = 6.0
        layout = "regular"
        show_caps_lock = true
        show_keyboard_layout = true
        show_login_button = true
        show_media = true
        show_session_buttons = true
        show_unlock_hint = true
        show_weather = true

[osd]
background_opacity = 0.79999998211860657
position = "bottom_right"

[plugin_settings."tyzq/phonto-wallpaper"]
run_as_systemd = true
video_directory = "{{ .chezmoi.homeDir }}/Videos/Wallpaper"

[plugins]
enabled = []

    [[plugins.source]]
    kind = "git"
    location = "https://github.com/noctalia-dev/official-plugins"
    name = "official"

    [[plugins.source]]
    kind = "git"
    location = "https://github.com/noctalia-dev/community-plugins"
    name = "community"

    [[plugins.source]]
    kind = "git"
    location = "https://github.com/HZ-TYZQ/Noctalia-Phonto-Wallpaper.git"
    name = "tyzq"

[shell]
corner_radius_scale = 2.0
launch_apps_as_systemd_services = true
password_style = "random"

    [shell.launcher]
    fetch_exchange_rates = false
    pinned = [ "com.qq.QQ", "proton.vpn.app.gtk", "com.google.Chrome", "firefox", "org.gnome.Nautilus", "yazi" ]

    [shell.panel]
    control_center_placement = "floating"

[theme]
builtin = "Ayu"
community_palette = "Catppuccin Macchiato Green"
mode = "dark"
source = "wallpaper"
wallpaper_scheme = "m3-content"

    [theme.templates]
    builtin_ids = [ "gtk3", "gtk4", "kcolorscheme", "niri", "qt" ]
    community_ids = []
    enable_community_templates = false

[wallpaper]
directory = "{{ .chezmoi.homeDir }}/Pictures/Wallpaper"

    [wallpaper.default]
    path = "{{ .chezmoi.homeDir }}/Pictures/Wallpaper/蔚蓝档案|柚鳥ナツ.png"

    [wallpaper.last]
    path = "{{ .chezmoi.homeDir }}/Pictures/Wallpaper/蔚蓝档案|柚鳥ナツ.png"

    [wallpaper.monitors.eDP-1]
    path = "{{ .chezmoi.homeDir }}/Pictures/Wallpaper/蔚蓝档案|柚鳥ナツ.png"

[widget.battery]
hide_when_plugged = true
label_content = "rate"

[widget.media]
hide_when_no_media = true
max_length = 120

[widget.network]
show_label = false

[widget.phonto]
type = "tyzq/phonto-wallpaper:phonto"

[widget.tray]
drawer = true
drawer_item_size = 20.0