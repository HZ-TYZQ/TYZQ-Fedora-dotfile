# 适用于本机的changelog, 不放入整体配置变更

/docs/本机系统变更记录

# Keep personal Git and npm configuration local.
/dot_gitconfig
/dot_config/git/config
/dot_config/npm/npmrc
/dot_config/npm/private_npmrc

# Claude Code: keep account details, credentials, and runtime data local.
/dot_claude*
/private_dot_claude*
/dot_config/claude/
/dot_config/private_claude/*
!/dot_config/private_claude/settings.json
!/dot_config/private_claude/executable_statusline-command.sh

# Local working files; review explicit paths before staging.
__pycache__/
*.pyc
*.swp
*.swo
*~

# Private configuration files

private_dot_local/
